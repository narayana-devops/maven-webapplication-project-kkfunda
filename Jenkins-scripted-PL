node {
def mvn = tool name:"3.9.11"

stage('git checkout')
{
git branch: 'jenkins', url: 'https://github.com/narayana-devops/maven-webapplication-project-kkfunda.git'

}

stage('Maven Build')

{
sh "${mvn}/bin/mvn clean package"
}
stage('Maven Sonar Report')
{
sh "${mvn}/bin/mvn sonar:sonar"
}
stage('Backup the artifactory to nexus')
{
sh "${mvn}/bin/mvn deploy"
}
stage('Deploy into tomcat')
{
sh """
curl -u admin:password \
--upload-file /var/lib/jenkins/workspace/pipline/target/maven-web-application.war \
"http://3.109.158.58:8080/manager/text/deploy?path=/maven-web-application&update=true"
"""
}
}
